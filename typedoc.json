{
  "$schema": "https://typedoc.org/schema.json",
  "out": "site",
  "excludePrivate": true,
  "treatWarningsAsErrors": true,
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": true
  },
  "highlightLanguages": [
    "bash",
    "java",
    "js",
    "json",
    "ts",
    "typescript"
  ],
  "ignoredHighlightLanguages": [
    "mermaid"
  ],
  "tsconfig": "./tsconfig.json",
  "entryPoints": [
    "src/index.ts",
    "src/front-door-plugin.ts",
    "src/serve-direct.ts",
    "src/profiles/anthropic.ts"
  ],
  "name": "@intisy-ai/claude-code-proxy",
  "sourceLinkTemplate": "https://github.com/intisy-ai/claude-code-proxy/blob/{gitRevision}/{path}#L{line}",
  "externalSymbolLinkMappings": {
    "@intisy-ai/basekit/ir": {
      "*": "https://github.com/intisy-ai/basekit"
    },
    "@intisy-ai/basekit/proxy": {
      "*": "https://github.com/intisy-ai/basekit"
    }
  }
}
