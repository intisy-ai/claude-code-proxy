{
  "name": "claude-code-proxy",
  "version": "1.1.0",
  "description": "The Claude/Anthropic proxy layer (anthropicProfile) on top of the generic core-proxy engine",
  "type": "module",
  "main": "dist/index.js",
  "license": "MIT",
  "author": "intisy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intisy-ai/claude-code-proxy.git"
  },
  "keywords": [
    "proxy",
    "routing",
    "anthropic",
    "claude",
    "intisy",
    "claude-code-proxy"
  ],
  "files": [
    "dist/",
    "plugin.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "npm run build:teavm && npx tsc && node build.mjs",
    "build:teavm": "node node_modules/@intisy-ai/api/scripts/teavm-build.mjs --java-dir . --module :claude-code-proxy-teavm --out src/generated/anthropic-rate-limit.teavm.js",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@intisy-ai/anthropic-translator": "^1.1.0",
    "@intisy-ai/core-ir": "^1.3.0",
    "@intisy-ai/core-proxy": "^2.0.0"
  },
  "devDependencies": {
    "@intisy-ai/api": "^1.0.2",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
