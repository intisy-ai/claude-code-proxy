{
  "name": "claude-code-proxy",
  "version": "2.0.1",
  "description": "The Claude/Anthropic proxy layer (anthropicProfile) on top of the generic core-proxy engine",
  "type": "module",
  "main": "dist/index.js",
  "license": "MIT",
  "author": "intisy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intisy-ai/claude-code-proxy.git"
  },
  "keywords": [
    "proxy",
    "routing",
    "anthropic",
    "claude",
    "intisy",
    "claude-code-proxy"
  ],
  "files": [
    "dist/",
    "plugin.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "npm run emit:teavm && npm run build:teavm && npx tsc && node build.mjs && npx esbuild src/front-door-plugin.ts --bundle --platform=node --format=esm --external:@intisy-ai/core-proxy --external:@intisy-ai/core-ir --external:@intisy-ai/anthropic-translator --outfile=dist/front-door-plugin.js",
    "build:teavm": "node node_modules/@intisy-ai/api/scripts/teavm-build.mjs --java-dir . --module :claude-code-proxy-teavm --out src/generated/anthropic-rate-limit.teavm.js",
    "test": "npm run build && vitest run",
    "prepublishOnly": "npm run build",
    "emit:teavm": "node node_modules/@intisy-ai/api/scripts/emit-dts.mjs --java-dir . --module :claude-code-proxy-teavm --out src/generated"
  },
  "dependencies": {
    "@intisy-ai/anthropic-translator": "^1.1.0",
    "@intisy-ai/core-ir": "^1.4.0",
    "@intisy-ai/core-proxy": "^2.0.0"
  },
  "devDependencies": {
    "@intisy-ai/api": "^1.6.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
